# ASTROMISSION Environment Configuration Example
# Copy to .env and customize for your deployment environment.
# NEVER commit real secrets or API keys to version control.

# Backend Configuration
APP_NAME="ASTROMISSION — Junior Astronaut Mission Trainer"
APP_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-secure-64-char-hex-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL in production; SQLite fallback supported for quick local setup)
# Example PostgreSQL URL: postgresql+psycopg2://postgres:postgres@localhost:5432/astromission
DATABASE_URL=sqlite:///./astromission.db

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# AI Commander Provider Configuration (Optional - uses built-in NASA-referenced scientific knowledge engine when omitted)
AI_PROVIDER=knowledge_engine
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=15
AI_RATE_LIMIT_PER_MINUTE=30

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1

